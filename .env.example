# DATA_DIR: basismap voor ALLE persistente data (opslag, users, keys, JSON-datastores).
# In Docker staat dit op /data (het volume). Laat leeg voor een bare-metal-install
# (dan wordt de projectmap gebruikt). Individuele *_FILE/*_DIR overschrijven dit nog.
#DATA_DIR=/data

# Kopieer dit bestand naar .env en vul je eigen waarden in.
# .env staat in .gitignore en wordt nooit gecommit.
# Bij de eerste start wordt .env automatisch aangemaakt met een
# willekeurig gegenereerd wachtwoord als het nog niet bestaat.

# Standaardgebruiker (wordt gebruikt om users.json te vullen bij eerste start).
AUTH_USER=admin
AUTH_PASS=verander-dit-wachtwoord

# Netwerkpoorten en -interfaces.
WEB_PORT=8080
WEB_HOST=0.0.0.0
SFTP_PORT=2222
SFTP_HOST=0.0.0.0

# Opslag, keys en gebruikers.
STORAGE_DIR=./storage
HOST_KEY_PATH=./host.key
USERS_FILE=./users.json
AUTHORIZED_KEYS_DIR=./authorized_keys
AUDIT_LOG=./audit.log

# HTTPS voor de web UI. Zet op true om TLS te gebruiken; er wordt dan
# automatisch een self-signed certificaat gegenereerd als er geen bestaat.
TLS_ENABLED=false
TLS_CERT=./tls/cert.pem
TLS_KEY=./tls/key.pem

# Brute-force-bescherming.
RATE_MAX_ATTEMPTS=5
RATE_WINDOW_MS=60000
RATE_BLOCK_MS=300000

# WebDAV, quota en prullenbak.
WEBDAV_ENABLED=true
DEFAULT_QUOTA=0
TRASH_NAME=.trash

# Bandbreedtelimiet voor downloads (bytes/s per stream, 0 = geen).
DEFAULT_BANDWIDTH=0

# Hervatbare uploads: map voor tijdelijke chunks.
CHUNK_DIR=./uploads-tmp

# Notificaties: webhook-URL (leeg = uit).
WEBHOOK_URL=

# Antivirus (optioneel): pad naar clamdscan/clamscan (leeg = uit).
CLAMSCAN=

# VirusTotal (optioneel): hash-lookup bij upload. VT_UPLOAD=true uploadt
# onbekende bestanden voor analyse (tot VT_MAX_UPLOAD_BYTES).
VT_API_KEY=
VT_MIN_DETECTIONS=1
VT_UPLOAD=false
VT_MAX_UPLOAD_BYTES=33554432

# Automatische E2E-sleutelrotatie: map-sleutels ouder dan N dagen (0 = uit).
KEY_ROTATE_DAYS=0

# Toegang beperken tot IP's/CIDR's (komma-gescheiden; leeg = iedereen).
IP_ALLOWLIST=

# Wachtwoordbeleid en accountvergrendeling.
PASSWORD_MIN_LENGTH=8
PASSWORD_REQUIRE_MIXED=false
LOCKOUT_MAX_ATTEMPTS=10
LOCKOUT_DURATION_MS=900000

# Geplande opschoning: prullenbak-items ouder dan N dagen verwijderen (0 = uit).
CLEANUP_TRASH_DAYS=0
CLEANUP_INTERVAL_HOURS=24

# Passkeys / WebAuthn (beide vereist om in te schakelen).
# rpID = domein (bijv. transfer.zepta-nas.nl); origin = volledige URL.
WEBAUTHN_RP_ID=
WEBAUTHN_ORIGIN=
WEBAUTHN_RP_NAME=SFTP Fileserver

# Antivirus-beleid. AV_FAIL_CLOSED=true weigert een upload als GEEN enkele engine
# het bestand kon scannen (onbereikbaar/niet geïnstalleerd). Een bestand is
# toegestaan zodra minstens één engine het goedkeurt; besmet bij één engine
# blokkeert altijd. AV_TIMEOUT_MS = max wachttijd per engine.
AV_FAIL_CLOSED=false
AV_TIMEOUT_MS=15000

# Off-site backup (optioneel): commando dat na elke upload draait met het
# bestandspad als laatste argument, bijv.: aws s3 cp
POST_UPLOAD_CMD=

# OpenID Connect / SSO (optioneel): alle vier vereist om in te schakelen.
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=

# Externe basis-URL (voor reset-links in e-mails), bijv. https://files.voorbeeld.nl
APP_BASE_URL=

# E-mail. Bij voorkeur Brevo. Twee opties:
#  1) Brevo transactionele API (aanbevolen): zet alleen BREVO_API_KEY + BREVO_FROM.
#  2) Brevo SMTP-relay: SMTP_HOST=smtp-relay.brevo.com, SMTP_USER=<login>,
#     SMTP_PASS=<SMTP-key>.
# Zonder configuratie wordt de resetlink in de console gelogd.
BREVO_API_KEY=
BREVO_FROM=jij@voorbeeld.nl
BREVO_FROM_NAME=SFTP Fileserver

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=fileserver@localhost

# E-mailadres dat deel-notificaties ontvangt (leeg = e-mail van de eigenaar).
NOTIFY_EMAIL=

# Antivirus-quarantaine en versiegeschiedenis.
QUARANTINE_DIR=./quarantine
KEEP_VERSIONS=10

# Prometheus-metrics op /metrics.
METRICS_ENABLED=true
METRICS_TOKEN=

# Ingebouwde back-upplanner (0 minuten = uit).
BACKUP_INTERVAL_MINUTES=0
BACKUP_DIR=./backups
BACKUP_KEEP=7

# Cache-map voor thumbnails.
THUMB_DIR=./thumbs-cache

# Permalinks per bestand (stabiele UUID-link).
PERMALINKS_FILE=./permalinks.json

# Onderhoud & alerts.
ALERT_EMAIL=
DISK_WARN_PERCENT=10
LOG_MAX_BYTES=5242880
LOG_KEEP=5
UPDATE_CHECK=true
UPDATE_REPO=SEVN132stack/Fileserver

# --- v3.14: extra beveiliging & hardening ---
# Back-ups versleutelen (AES-256-GCM). Leeg = onversleuteld.
BACKUP_PASSWORD=
# Off-site kopie na elke back-up, bijv. "rclone copy" of "aws s3 cp".
BACKUP_UPLOAD_CMD=
# Ransomware-/massa-wijziging-detectie: alarm bij N destructieve acties per venster.
RANSOMWARE_THRESHOLD=50
RANSOMWARE_WINDOW_MS=60000
# Tweefactor afdwingen: off | admin | all.
REQUIRE_2FA=off
# Shell-commando bij ban/unban (fail2ban-hook). Ontvangt "ban <ip>" / "unban <ip>".
BAN_CMD=
# Geo-blokkering: alleen deze landcodes toestaan (komma-gescheiden, leeg = alle).
GEO_ALLOW=
GEO_HEADER=cf-ipcountry
# SFTP: wachtwoord-auth toestaan. false = alleen publieke sleutels.
SFTP_PASSWORD_AUTH=true
# Periodieke bestandsintegriteitscontrole (0 = uit).
INTEGRITY_INTERVAL_HOURS=0
# Honeypot-/lokbestanden (komma-gescheiden paden). Toegang triggert alarm.
HONEYPOTS=
# SIEM-endpoint: audit-events als JSON doorsturen (POST).
SIEM_URL=
# Wachtwoorden controleren tegen HaveIBeenPwned (k-anonimiteit).
PASSWORD_HIBP=false

# --- v3.15: extra beveiliging, onderhoud & organisatie ---
# Sessie-binding tegen cookie-diefstal: off | ip | ua | both. Standaard: both.
# Let op: 'ip'/'both' kan mobiele gebruikers uitloggen bij wisselend IP → kies 'ua'.
SESSION_BIND=both
# Step-up: gevoelige beheeracties vereisen recente wachtwoord-herbevestiging (ms; 0 = uit).
REAUTH_WINDOW_MS=300000
# Zoekindex (omgekeerde index) voor snelle zoekacties. Interval in minuten (0 = alleen op verzoek).
SEARCH_INDEX_FILE=./search-index.json
SEARCH_INDEX_INTERVAL=0
# Tags/labels per bestand.
TAGS_FILE=./tags.json
# ClamAV-onderhoud: definitie-updates en geplande volledige scan (0 = uit).
FRESHCLAM_CMD=
FRESHCLAM_INTERVAL_HOURS=0
AV_SCAN_INTERVAL_HOURS=0
# Back-up herstel-test: ontsleutel + valideer de ZIP-structuur na elke back-up.
BACKUP_RESTORE_TEST=false

# --- Bestand-gebaseerde geheimen (Docker/Podman secrets, Kubernetes, Vault, systemd) ---
# Voor elk geheim kun je in plaats van de waarde een <NAAM>_FILE zetten dat naar
# een bestand wijst; de inhoud wordt als het geheim geladen. Ondersteund voor:
# AUTH_PASS, SESSION_SECRET, SMTP_PASS, SMTP_USER, BREVO_API_KEY, VT_API_KEY,
# BACKUP_PASSWORD, METRICS_TOKEN, OIDC_CLIENT_SECRET.
# Voorbeeld (Docker secret): AUTH_PASS_FILE=/run/secrets/auth_pass
#AUTH_PASS_FILE=
# systemd: zet LoadCredential=AUTH_PASS:/etc/fileserver/auth_pass; de service leest
# het automatisch uit $CREDENTIALS_DIRECTORY (geen _FILE nodig).

# --- v3.16: privacy, samenwerking, media & multi-tenant ---
# Toegangslog voor gedeelde bestanden (wie downloadde wat, wanneer).
SHARE_ACCESS_FILE=./share-access.json
# Watermerk op gedeelde afbeeldingen (recipient + datum; alleen afbeeldingen).
WATERMARK_SHARES=false
# Sessie-timeout bij inactiviteit (ms, 0 = uit).
IDLE_TIMEOUT_MS=0
# Wachtwoordverval (dagen, 0 = uit) + aantal onthouden oude wachtwoorden.
PASSWORD_MAX_AGE_DAYS=0
PASSWORD_HISTORY=5
# Bestandsvergrendeling.
LOCKS_FILE=./locks.json
# Geplande exports (rsync/rclone) + interval.
SCHEDULED_EXPORTS_FILE=./scheduled-exports.json
SCHEDULED_EXPORT_INTERVAL=60
# ffmpeg voor video-poster/audio-golfvorm (leeg = uit). Bijv. FFMPEG_CMD=ffmpeg
FFMPEG_CMD=
# Automatische TLS via extern ACME-commando (certbot/acme.sh) + verleng-interval.
ACME_CMD=
ACME_RENEW_INTERVAL_HOURS=0
# Config-drift: waarschuw als databestanden buiten de app om wijzigen (minuten, 0 = uit).
CONFIG_DRIFT_INTERVAL=0
# Huisstijl (ook via admin-instellingen).
APP_NAME=SFTP Fileserver
LOGO_URL=
ACCENT_COLOR=

# --- v3.16.2: security-hardening ---
# Welke proxy's te vertrouwen voor het client-IP (X-Forwarded-For): '1' = alleen
# de directe proxy (Caddy/nginx) — aanbevolen. 'true' = alle proxy's (alleen als je
# meerdere hebt), 'false' = geen proxy (app direct benaderbaar). Fout ingesteld =
# IP-spoofing mogelijk (ban/rate-limit/geo/allowlist omzeilen).
TRUST_PROXY=1
# Zet METRICS_TOKEN als /metrics publiek bereikbaar is: zonder token worden er
# GEEN per-gebruiker-metrics (gebruikersnamen + verkeer) getoond.

# --- v3.16.3: upload-limiet & cookie-hardening ---
# Maximale uploadgrootte per bestand in bytes (0 = onbeperkt). Beschermt tegen
# schijf-vol-DoS, ook via anonieme drop-links. Bijv. 1073741824 = 1 GB.
MAX_UPLOAD_BYTES=0
# Cookie 'Secure'-vlag: 'auto' = alleen bij eigen TLS (TLS_ENABLED=true).
# Zet op 'true' als je achter een TLS-terminerende proxy (Caddy/nginx) draait,
# zodat de sessie-cookie altijd de Secure-vlag krijgt.
COOKIE_SECURE=auto

# --- v3.17: DLP, break-glass, rate-limiting, rapportage ---
# DLP (Data Loss Prevention): scan tekstuele uploads op BSN/creditcard/IBAN/
# wachtwoorden. off | flag (markeren + alarm) | block (in quarantaine).
DLP_ACTION=off
DLP_MAX_BYTES=2097152
# Break-glass nood-admin: normaal ongebruikt; elk gebruik alarmeert luid.
# Laat beide leeg om uit te schakelen. Zet een sterk, uniek wachtwoord.
BREAKGLASS_USER=
BREAKGLASS_PASSWORD=
# Algemene API-rate-limiting per IP (0 = uit).
API_RATE_MAX=0
API_RATE_WINDOW_MS=60000
# Download-rate-limiting per IP (beschermt tegen scraping; 0 = uit).
DOWNLOAD_RATE_MAX=0
DOWNLOAD_RATE_WINDOW_MS=60000
# Inactieve accounts markeren na dit aantal dagen zonder login (rapportage).
INACTIVE_DAYS=90

# --- v3.18: compliance, samenwerking, integraties ---
# WORM/retentie + self-destruct + E2E-verplichte mappen (databestanden).
RETENTION_FILE=./retention.json
EXPIRY_FILE=./file-expiry.json
EXPIRY_INTERVAL=60
E2E_FOLDERS_FILE=./e2e-folders.json
# Per-gebruiker API-sleutels en in-app notificaties.
API_KEYS_FILE=./api-keys.json
NOTIFICATIONS_FILE=./notifications.json
# Document->PDF conversie via LibreOffice (leeg = uit). Bijv. SOFFICE_CMD=soffice
SOFFICE_CMD=
# Wekelijks e-mailrapport naar ALERT_EMAIL (uren, 0 = uit). Bijv. 168 = wekelijks.
REPORT_EMAIL_INTERVAL_HOURS=0
# Webhook-formaat: generic | slack | discord | teams | ntfy.
WEBHOOK_TYPE=generic
# Gestructureerde JSON-logging (voor log-aggregatie/OpenTelemetry-collectors).
LOG_JSON=false

# --- v3.19: OCR, auto-tagging, toegangsaanvragen, geplande taken ---
# OCR: tekst uit afbeeldingen/PDF's halen (doorzoekbaar). Extern commando dat het
# bestandspad + 'stdout' krijgt, bijv. OCR_CMD=tesseract. Leeg = uit.
OCR_CMD=
OCR_FILE=./ocr-index.json
OCR_MAX_BYTES=10485760
# Automatische categorisatie/tagging van uploads op type + inhoud.
AUTO_TAG=false
# Toegangsaanvraag-workflow (map-toegang aanvragen bij de eigenaar).
ACCESS_REQUESTS_FILE=./access-requests.json
# Per-gebruiker geplande taken (opschoning) + scheduler-interval (minuten).
USER_TASKS_FILE=./user-tasks.json
USER_TASKS_INTERVAL=15

# --- v3.20: auth, samenwerking, ops ---
# Zelfregistratie met invite-codes.
INVITES_FILE=./invites.json
# Uitgaande webhook-wachtrij (retries + afleveringslog).
WEBHOOK_QUEUE_FILE=./webhook-queue.json
WEBHOOK_MAX_RETRIES=5
# Onveranderbare snapshots (reflink-kopieën waar het FS het ondersteunt).
SNAPSHOTS_DIR=./snapshots
# Per-map informatie (beschrijving/kleur/icoon).
FOLDER_INFO_FILE=./folder-info.json
# Quota-waarschuwing per e-mail bij dit gebruikspercentage (0 = uit).
QUOTA_WARN_PERCENT=0
QUOTA_WARN_INTERVAL_HOURS=24
# Certificaat-vervalbewaking: waarschuw N dagen vooraf (alleen bij eigen TLS).
CERT_WARN_DAYS=14
# Magic-link login: geldigheid van de inloglink in minuten (vereist e-mail).
MAGIC_LINK_TTL_MIN=15

# --- v3.20.1 (prestatie-tuning) ---
# Hoe lang (ms) de berekende map-grootte gecachet wordt voor quota-checks/weergave.
# 0 = uitschakelen (altijd vers berekenen). Cache wordt bij elke wijziging geïnvalideerd.
DIRSIZE_CACHE_MS=5000
# Maximum aantal snapshots per gebruiker (schijf-uitputting voorkomen).
MAX_SNAPSHOTS_PER_USER=50

# --- v3.21 (beveiliging) ---
# Vereis een hardware-backed FIDO2 (sk-) SSH-sleutel voor SFTP (weigert wachtwoord + gewone keys).
SFTP_REQUIRE_HARDWARE_KEY=false
# Geo-/IP-blokkering. Landcodes (ISO-2, kommagescheiden) werken via de geo-header (GEO_HEADER).
BLOCKED_COUNTRIES=
# CIDR-blokken (kommagescheiden), gelden ook voor SFTP. Bijv: 203.0.113.0/24,10.0.0.5
BLOCKED_CIDRS=
# Just-in-time toegang: maximale duur (uren) van een tijdelijke rol-verhoging.
JIT_MAX_HOURS=4
# Anomalie-detectie: alarmeer bij > N downloads of > N bytes per uur per gebruiker (0 = uit).
ANOMALY_DL_COUNT=0
ANOMALY_DL_BYTES=0

# --- v3.22 (samenwerking) ---
# Gedeelde teamruimtes: metadata + opslagmap.
TEAMS_FILE=teams.json
TEAM_SPACES_DIR=teamspaces
# Maximale grootte per teamruimte (bytes, 0 = onbeperkt).
TEAM_SPACE_MAX_BYTES=0
# Goedkeuringsworkflow: reviewstatus per bestand.
REVIEWS_FILE=reviews.json

# --- v3.23 (zoeken & inzicht) ---
# Neem ook de tekst uit kantoordocumenten (docx/xlsx/pptx) mee in de zoekindex.
INDEX_OFFICE_CONTENT=true
# Opgeslagen zoekopdrachten / slimme mappen per gebruiker.
SAVED_SEARCHES_FILE=saved-searches.json

# --- v3.24 (integraties & UX) ---
# Inkomende webhooks / API-triggers: token -> vooraf toegestane actie.
INBOUND_HOOKS_FILE=inbound-hooks.json

# --- v3.25 (beveiliging & identiteit) ---
# Data-classificatielabels per bestand (openbaar/intern/vertrouwelijk/geheim).
LABELS_FILE=labels.json
# Vereis dat een apparaat expliciet vertrouwd is voordat het mag inloggen
# (het eerste apparaat van een gebruiker wordt automatisch vertrouwd).
REQUIRE_DEVICE_APPROVAL=false

# --- v3.27 (automatisering & notificaties) ---
# Regelgebaseerde automatisering (als upload in map X -> tag/verplaats/notificeer).
RULES_FILE=rules.json
# Map-abonnementen: melding bij wijzigingen in een gevolgde map.
SUBSCRIPTIONS_FILE=subscriptions.json
# Digest-notificaties: verzamel meldingen en mail periodiek een samenvatting.
DIGEST_PREFS_FILE=digest-prefs.json
DIGEST_INTERVAL_HOURS=24

# --- v3.28 (media & bewerking) ---
# Spraak-naar-tekst commando voor automatische transcriptie (bijv. whisper). Leeg = uit.
TRANSCRIBE_CMD=
# (Transcoderen hergebruikt FFMPEG_CMD; zie hierboven.)

# --- v3.29 (opslag & continuïteit) ---
# Compressie-at-rest: comprimeer bestanden die N dagen niet zijn gewijzigd (0 = handmatig/uit).
COLD_STORE_DAYS=0
COLD_STORE_MIN_BYTES=4096
# Server-brede point-in-time snapshots van de hele opslag.
SERVER_SNAPSHOTS_DIR=server-snapshots
SERVER_SNAPSHOTS_KEEP=10
# Zelftest (back-up-herstel + integriteit): interval in uren (0 = alleen handmatig).
SELFTEST_INTERVAL_HOURS=0
# Statuspagina: incidenten + onderhoudsvensters.
INCIDENTS_FILE=incidents.json

# --- v3.30 (API & extensibiliteit) ---
# Plugin-/extensiesysteem: koppel events aan externe commando's. KRACHTIG -> standaard uit.
EVENT_HOOKS_ENABLED=false
EVENT_HOOKS_FILE=event-hooks.json
# Fijnmazige uitgaande webhook-abonnementen (filters + payload-templates).
WEBHOOK_SUBS_FILE=webhook-subs.json

# --- v3.31 (UX & toegankelijkheid) ---
# Vastgezette mappen per gebruiker (dashboard-snelkoppelingen).
PINS_FILE=pins.json

# --- v3.32 (vertrouwen & workflow) ---
# Digitale ondertekening (server Ed25519-sleutelpaar + register).
SIGNING_KEY_FILE=signing-key.json
SIGNATURES_FILE=signatures.json
# Veilig verwijderen: aantal overschrijf-passes (0 = uit, normaal naar prullenbak).
SHRED_PASSES=1
# Taken/actiepunten op bestanden.
TASKS_FILE=file-tasks.json

# --- v3.33 (AI & slimme organisatie) ---
# AI-assistent: extern commando dat de prompt op stdin krijgt en antwoord op stdout
# schrijft (bv. een lokale LLM-CLI). Leeg = uit.
AI_CMD=
AI_MAX_CONTEXT=8000
# Beeldherkenning: extern commando dat een afbeeldingspad krijgt en JSON met labels
# ({"labels":["kat"]} of ["kat"]) op stdout schrijft. Leeg = uit.
VISION_CMD=
VISION_FILE=vision-index.json
VISION_MAX_BYTES=10485760
# Mapstructuur-suggesties werken volledig lokaal (geen instelling nodig).

# --- v3.34 (invoer & integraties) ---
# Upload via e-mail: opslag van inbox-tokens + doelsubmap + max. bijlagegrootte.
EMAIL_INBOX_FILE=email-inbox.json
EMAIL_INBOX_DIR=Inbox-mail
EMAIL_INBOX_MAX_BYTES=26214400
# Scan-naar-map (hot-folder): host-map die periodiek naar een gebruiker wordt geleegd.
# Leeg = uit.
HOTFOLDER_DIR=
HOTFOLDER_USER=
HOTFOLDER_TARGET=Ingescand
HOTFOLDER_INTERVAL_SEC=60
# Chat-bot: gedeelde token voor inkomende commando's + gebruiker in wiens home de bot
# zoekt/lijst. Uitgaande meldingen lopen via WEBHOOK_URL (zie boven).
CHAT_BOT_TOKEN=
CHAT_BOT_USER=

# --- v3.35 (weergave & inzicht) ---
# Max. aantal bestanden dat per kaart/tijdlijn/grafiek-verzoek wordt doorlopen.
INSIGHTS_MAX_SCAN=5000

# Webhook voor deploy-meldingen (Discord → kanaalinstellingen → Integraties).
# Elke app heeft een eigen webhook, zodat meldingen per app te volgen zijn.
# Leeg laten = geen meldingen; de deploy draait dan gewoon door.
DISCORD_WEBHOOK_URL=
